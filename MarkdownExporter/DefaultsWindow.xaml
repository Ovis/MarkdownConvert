<Window x:Class="MarkdownExporter.DefaultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MarkdownExporter.Localization"
        Title="{loc:Tr DefaultSettings}" Icon="Assets/AppIcon.ico" Width="600" Height="550" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterOwner" Style="{StaticResource UiStyle.Window}" SourceInitialized="Window_SourceInitialized">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{loc:Tr DefaultSettings}" Style="{StaticResource UiStyle.SectionHeading}" FontSize="20"/>
        <Border Grid.Row="2" Style="{StaticResource UiStyle.Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="{loc:Tr Appearance}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeChanged" Margin="0,0,0,16">
                        <ComboBoxItem Content="{loc:Tr ThemeSystem}"/><ComboBoxItem Content="{loc:Tr ThemeLight}"/><ComboBoxItem Content="{loc:Tr ThemeDark}"/>
                    </ComboBox>
                    <TextBlock Text="{loc:Tr Language}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageChanged" Margin="0,0,0,16">
                        <ComboBoxItem Content="{loc:Tr LanguageSystem}"/><ComboBoxItem Content="{loc:Tr Japanese}"/><ComboBoxItem Content="{loc:Tr English}"/>
                    </ComboBox>
                    <TextBlock Text="{loc:Tr OutputFormat}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                        <CheckBox x:Name="HtmlCheck" Content="HTML" Margin="0,0,18,0"/>
                        <CheckBox x:Name="PdfCheck" Content="PDF"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Tr OutputDirectoryWithHint}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                        <TextBox x:Name="OutputText" Width="340" Height="{StaticResource UiSize.ControlHeight}"/>
                        <Button Content="{loc:Tr Browse}" Click="OutputBrowse_Click" Margin="5,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Tr Template}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ComboBox x:Name="TemplateCombo" Width="235"/>
                        <Button Content="{loc:Tr OpenTemplateFolder}" Click="OpenTemplate_Click" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                        <Button Content="{loc:Tr RefreshTemplateList}" Click="RefreshTemplates_Click"/>
                        <Button Content="{loc:Tr ResetDefaultTemplate}" Click="ResetTemplate_Click" Margin="6,0,0,0" Style="{StaticResource UiStyle.QuietButton}"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Tr HtmlImages}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <CheckBox x:Name="EmbedCheck" Content="{loc:Tr EmbedInHtml}" Margin="0,0,0,13"/>
                    <TextBlock Text="{loc:Tr PdfOrientation}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                        <RadioButton x:Name="PortraitRadio" Content="{loc:Tr Portrait}" GroupName="Orientation" Margin="0,0,18,0"/>
                        <RadioButton x:Name="LandscapeRadio" Content="{loc:Tr Landscape}" GroupName="Orientation"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Tr FigureDisplay}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <CheckBox x:Name="FitCheck" Content="{loc:Tr FitOnePage}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Save}" Click="Save_Click" Style="{StaticResource UiStyle.PrimaryButton}"
                    MinWidth="85" Margin="0,0,8,0"/>
            <Button Content="{loc:Tr Cancel}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
