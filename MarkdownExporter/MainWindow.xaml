<Window x:Class="MarkdownExporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MarkdownExporter.Localization"
        Title="MarkdownExporter" Icon="Assets/AppIcon.ico" Width="1120" Height="660" MinWidth="900" MinHeight="540"
        WindowStartupLocation="CenterScreen" Style="{StaticResource UiStyle.Window}"
        SourceInitialized="Window_SourceInitialized">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource UiStyle.Panel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="FileCount" Style="{StaticResource UiStyle.SectionHeading}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{loc:Tr AddFiles}" Click="AddFiles_Click" Margin="0,0,6,0"/>
                            <Button Content="{loc:Tr RemoveSelected}" Click="RemoveFiles_Click" Style="{StaticResource UiStyle.QuietButton}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                    <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Files}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Extended" SelectionUnit="FullRow"
                              AllowDrop="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Tr File}" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="{StaticResource UiPadding.FileCell}"
                                                    ToolTip="{Binding Detail}">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource UiStyle.TableFileName}"/>
                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontSize="10"
                                                       Style="{StaticResource UiStyle.MutedText}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:Tr Encoding}" Width="126">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding EncodingOptions}" SelectedItem="{Binding SelectedEncodingOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  TextSearch.TextPath="Name" Style="{StaticResource UiStyle.TableComboBox}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="HTML" Binding="{Binding HtmlStatus}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource UiStyle.TableStatusText}"/>
                            <DataGridTextColumn Header="PDF" Binding="{Binding PdfStatus}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource UiStyle.TableStatusText}"/>
                            <DataGridTextColumn Header="{loc:Tr State}" Binding="{Binding State}" IsReadOnly="True" Width="80" ElementStyle="{StaticResource UiStyle.TableStatusText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{loc:Tr DropMarkdown}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource UiStyle.MutedText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=FilesGrid}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                    <TextBlock x:Name="Status" Grid.Row="3" TextWrapping="Wrap"
                               Style="{StaticResource UiStyle.MutedText}" Margin="0,10,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource UiStyle.Sidebar}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="15"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr ConversionSettings}" Style="{StaticResource UiStyle.SectionHeading}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{loc:Tr DefaultSettings}" Click="Defaults_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr OutputFormat}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox x:Name="HtmlCheck" Content="HTML" IsChecked="True" Margin="0,0,18,0"/>
                                <CheckBox x:Name="PdfCheck" Content="PDF" IsChecked="True"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Tr OutputDirectory}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <RadioButton x:Name="SourceFolderRadio" Content="{loc:Tr OutputSourceFolder}"
                                         GroupName="OutputFolder" IsChecked="True" Margin="0,0,0,2"/>
                            <RadioButton x:Name="CustomFolderRadio" Content="{loc:Tr OutputCustomFolder}"
                                         GroupName="OutputFolder" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                        IsEnabled="{Binding IsChecked, ElementName=CustomFolderRadio}">
                                <TextBox x:Name="OutputText" Width="210" Height="{StaticResource UiSize.ControlHeight}"/>
                                <Button Content="{loc:Tr Browse}" Click="OutputBrowse_Click" Margin="5,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Tr Template}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ComboBox x:Name="TemplateCombo" Width="185"/>
                                <Button Content="{loc:Tr Browse}" Click="TemplateBrowse_Click" Margin="5,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Tr HtmlImages}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <CheckBox x:Name="EmbedCheck" Content="{loc:Tr EmbedInHtml}" Margin="0,0,0,12"/>
                            <TextBlock Text="{loc:Tr PdfOrientation}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="PortraitRadio" Content="{loc:Tr Portrait}" IsChecked="True" GroupName="Orientation" Margin="0,0,18,0"/>
                                <RadioButton x:Name="LandscapeRadio" Content="{loc:Tr Landscape}" GroupName="Orientation"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Tr FigureDisplay}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <CheckBox x:Name="FitCheck" Content="{loc:Tr FitOnePage}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Content="{loc:Tr RestoreDefaults}" Click="RestoreDefaults_Click" Style="{StaticResource UiStyle.QuietButton}" HorizontalAlignment="Left"/>
                        <Button x:Name="ConvertButton" Grid.Column="1" Content="{loc:Tr Convert}" Click="Convert_Click" Style="{StaticResource UiStyle.PrimaryButton}"/>
                    </Grid>
                </Grid>
            </Border>
    </Grid>
</Window>
